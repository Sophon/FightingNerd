CREATE TABLE DBFZMoveEntity (
    moveId TEXT NOT NULL PRIMARY KEY,
    attribute TEXT,
    smash TEXT,
    kiGain TEXT,
    prorate TEXT,
    blockStun TEXT,
    groundHit TEXT,
    airHit TEXT,
    level TEXT,
    FOREIGN KEY (moveId) REFERENCES MoveEntity(id) ON DELETE CASCADE
);

insertDBFZMove:
INSERT OR REPLACE INTO DBFZMoveEntity(moveId, attribute, smash, kiGain, prorate, blockStun, groundHit, airHit, level)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
