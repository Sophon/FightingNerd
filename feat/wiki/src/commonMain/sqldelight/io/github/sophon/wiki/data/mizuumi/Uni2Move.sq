CREATE TABLE uni2_move (
    move_id INTEGER PRIMARY KEY REFERENCES move(id) ON DELETE CASCADE,
    input_info TEXT,
    subtitle TEXT,
    min_damage TEXT,
    cancel_window TEXT,
    mizuumi_property TEXT,
    cost TEXT,
    attribute TEXT,
    landing TEXT,
    overall TEXT,
    assault_adv TEXT,
    blockstun TEXT,
    ground_hit TEXT,
    air_hit TEXT,
    ground_ch TEXT,
    air_ch TEXT,
    hitstop TEXT,
    ch_stop TEXT,
    proration TEXT,
    combo_p1 TEXT,
    combo_p2 TEXT
);

upsert:
INSERT INTO uni2_move(
    move_id,
    input_info,
    subtitle,
    min_damage,
    cancel_window,
    mizuumi_property,
    cost,
    attribute,
    landing,
    overall,
    assault_adv,
    blockstun,
    ground_hit,
    air_hit,
    ground_ch,
    air_ch,
    hitstop,
    ch_stop,
    proration,
    combo_p1,
    combo_p2
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (move_id) DO UPDATE SET
    input_info = excluded.input_info,
    subtitle = excluded.subtitle,
    min_damage = excluded.min_damage,
    cancel_window = excluded.cancel_window,
    mizuumi_property = excluded.mizuumi_property,
    cost = excluded.cost,
    attribute = excluded.attribute,
    landing = excluded.landing,
    overall = excluded.overall,
    assault_adv = excluded.assault_adv,
    blockstun = excluded.blockstun,
    ground_hit = excluded.ground_hit,
    air_hit = excluded.air_hit,
    ground_ch = excluded.ground_ch,
    air_ch = excluded.air_ch,
    hitstop = excluded.hitstop,
    ch_stop = excluded.ch_stop,
    proration = excluded.proration,
    combo_p1 = excluded.combo_p1,
    combo_p2 = excluded.combo_p2;

selectByCharacter:
SELECT *
FROM uni2_move
WHERE move_id IN (
    SELECT id
    FROM move
    WHERE character_id = (SELECT id FROM character WHERE game = ? AND natural_id = ?)
);
