CREATE TABLE roa2_character (
    character_id INTEGER PRIMARY KEY REFERENCES character(id) ON DELETE CASCADE,
    dacus_speed_multiplier TEXT,
    weight TEXT,
    friction_ground TEXT,
    friction_air TEXT,
    dash_frames TEXT,
    dash_speed TEXT,
    dash_acceleration TEXT,
    run_speed_max TEXT,
    run_turn_acceleration TEXT,
    run_turn_frames TEXT,
    walk_acceleration_max TEXT,
    walk_speed_max TEXT,
    gravity TEXT,
    hitstun_gravity TEXT,
    fall_speed_max TEXT,
    fast_fall_speed TEXT,
    air_acceleration TEXT,
    air_speed_horizontal_max TEXT,
    jump_speed_horizontal_max TEXT,
    full_hop_speed TEXT,
    short_hop_speed TEXT,
    double_jump_speed TEXT,
    double_jump_max_horizontal_speed TEXT,
    air_dodge_speed TEXT,
    air_dodge_friction TEXT,
    roll_speed TEXT,
    shield_size_multiplier TEXT,
    ledge_stand_speed TEXT,
    ledge_roll_speed TEXT,
    ledge_jump_max_horizontal_air_speed TEXT,
    getup_roll_speed TEXT,
    tech_roll_speed TEXT,
    wall_jump_speed_y TEXT,
    wall_jump_speed_x TEXT
);

upsert:
INSERT INTO roa2_character(
    character_id,
    dacus_speed_multiplier,
    weight,
    friction_ground,
    friction_air,
    dash_frames,
    dash_speed,
    dash_acceleration,
    run_speed_max,
    run_turn_acceleration,
    run_turn_frames,
    walk_acceleration_max,
    walk_speed_max,
    gravity,
    hitstun_gravity,
    fall_speed_max,
    fast_fall_speed,
    air_acceleration,
    air_speed_horizontal_max,
    jump_speed_horizontal_max,
    full_hop_speed,
    short_hop_speed,
    double_jump_speed,
    double_jump_max_horizontal_speed,
    air_dodge_speed,
    air_dodge_friction,
    roll_speed,
    shield_size_multiplier,
    ledge_stand_speed,
    ledge_roll_speed,
    ledge_jump_max_horizontal_air_speed,
    getup_roll_speed,
    tech_roll_speed,
    wall_jump_speed_y,
    wall_jump_speed_x
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (character_id) DO UPDATE SET
    dacus_speed_multiplier = excluded.dacus_speed_multiplier,
    weight = excluded.weight,
    friction_ground = excluded.friction_ground,
    friction_air = excluded.friction_air,
    dash_frames = excluded.dash_frames,
    dash_speed = excluded.dash_speed,
    dash_acceleration = excluded.dash_acceleration,
    run_speed_max = excluded.run_speed_max,
    run_turn_acceleration = excluded.run_turn_acceleration,
    run_turn_frames = excluded.run_turn_frames,
    walk_acceleration_max = excluded.walk_acceleration_max,
    walk_speed_max = excluded.walk_speed_max,
    gravity = excluded.gravity,
    hitstun_gravity = excluded.hitstun_gravity,
    fall_speed_max = excluded.fall_speed_max,
    fast_fall_speed = excluded.fast_fall_speed,
    air_acceleration = excluded.air_acceleration,
    air_speed_horizontal_max = excluded.air_speed_horizontal_max,
    jump_speed_horizontal_max = excluded.jump_speed_horizontal_max,
    full_hop_speed = excluded.full_hop_speed,
    short_hop_speed = excluded.short_hop_speed,
    double_jump_speed = excluded.double_jump_speed,
    double_jump_max_horizontal_speed = excluded.double_jump_max_horizontal_speed,
    air_dodge_speed = excluded.air_dodge_speed,
    air_dodge_friction = excluded.air_dodge_friction,
    roll_speed = excluded.roll_speed,
    shield_size_multiplier = excluded.shield_size_multiplier,
    ledge_stand_speed = excluded.ledge_stand_speed,
    ledge_roll_speed = excluded.ledge_roll_speed,
    ledge_jump_max_horizontal_air_speed = excluded.ledge_jump_max_horizontal_air_speed,
    getup_roll_speed = excluded.getup_roll_speed,
    tech_roll_speed = excluded.tech_roll_speed,
    wall_jump_speed_y = excluded.wall_jump_speed_y,
    wall_jump_speed_x = excluded.wall_jump_speed_x;

selectAll:
SELECT *
FROM roa2_character;
