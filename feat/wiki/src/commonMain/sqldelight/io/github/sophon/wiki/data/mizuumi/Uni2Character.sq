CREATE TABLE uni2_character (
    character_id INTEGER PRIMARY KEY REFERENCES character(id) ON DELETE CASCADE,
    smart_steer TEXT,
    f_walk_speed TEXT,
    f_walk_speed_note TEXT,
    b_walk_speed TEXT,
    b_walk_speed_note TEXT,
    jump_startup TEXT,
    jump_duration TEXT,
    jump_duration_note TEXT,
    dash_startup TEXT,
    i_dash_speed TEXT,
    i_dash_speed_note TEXT,
    dash_accel TEXT,
    dash_accel_note TEXT,
    max_dash_speed TEXT,
    b_dash_startup TEXT,
    b_dash_duration TEXT,
    b_dash_duration_note TEXT,
    b_dash_distance TEXT,
    b_dash_distance_note TEXT,
    b_dash_full_invul_start TEXT,
    b_dash_full_invul_end TEXT,
    b_dash_throw_invul_start TEXT,
    b_dash_throw_invul_end TEXT,
    throw_width TEXT,
    throw_range TEXT,
    trait TEXT,
    vorpal_trait TEXT
);

upsert:
INSERT INTO uni2_character(
    character_id,
    smart_steer,
    f_walk_speed,
    f_walk_speed_note,
    b_walk_speed,
    b_walk_speed_note,
    jump_startup,
    jump_duration,
    jump_duration_note,
    dash_startup,
    i_dash_speed,
    i_dash_speed_note,
    dash_accel,
    dash_accel_note,
    max_dash_speed,
    b_dash_startup,
    b_dash_duration,
    b_dash_duration_note,
    b_dash_distance,
    b_dash_distance_note,
    b_dash_full_invul_start,
    b_dash_full_invul_end,
    b_dash_throw_invul_start,
    b_dash_throw_invul_end,
    throw_width,
    throw_range,
    trait,
    vorpal_trait
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (character_id) DO UPDATE SET
    smart_steer = excluded.smart_steer,
    f_walk_speed = excluded.f_walk_speed,
    f_walk_speed_note = excluded.f_walk_speed_note,
    b_walk_speed = excluded.b_walk_speed,
    b_walk_speed_note = excluded.b_walk_speed_note,
    jump_startup = excluded.jump_startup,
    jump_duration = excluded.jump_duration,
    jump_duration_note = excluded.jump_duration_note,
    dash_startup = excluded.dash_startup,
    i_dash_speed = excluded.i_dash_speed,
    i_dash_speed_note = excluded.i_dash_speed_note,
    dash_accel = excluded.dash_accel,
    dash_accel_note = excluded.dash_accel_note,
    max_dash_speed = excluded.max_dash_speed,
    b_dash_startup = excluded.b_dash_startup,
    b_dash_duration = excluded.b_dash_duration,
    b_dash_duration_note = excluded.b_dash_duration_note,
    b_dash_distance = excluded.b_dash_distance,
    b_dash_distance_note = excluded.b_dash_distance_note,
    b_dash_full_invul_start = excluded.b_dash_full_invul_start,
    b_dash_full_invul_end = excluded.b_dash_full_invul_end,
    b_dash_throw_invul_start = excluded.b_dash_throw_invul_start,
    b_dash_throw_invul_end = excluded.b_dash_throw_invul_end,
    throw_width = excluded.throw_width,
    throw_range = excluded.throw_range,
    trait = excluded.trait,
    vorpal_trait = excluded.vorpal_trait;

selectAll:
SELECT *
FROM uni2_character;
