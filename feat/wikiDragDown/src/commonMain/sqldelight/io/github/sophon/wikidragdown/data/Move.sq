import kotlin.Boolean;

CREATE TABLE MoveEntity (
    id TEXT NOT NULL PRIMARY KEY,
    characterId TEXT NOT NULL,
    gameId TEXT NOT NULL,
    name TEXT,
    input TEXT NOT NULL,
    damage TEXT,
    startup TEXT,
    active TEXT,
    recovery TEXT,
    onBlock TEXT,
    onHit TEXT,
    onCH TEXT,
    guard TEXT,
    cancel TEXT,
    invulnerability TEXT,
    isThrow INTEGER AS Boolean NOT NULL DEFAULT 0,
    notes TEXT NOT NULL,
    aliases TEXT NOT NULL,
    urlsWikiUrl TEXT,
    urlsVideoId TEXT,
    urlsHitboxImageList TEXT NOT NULL,
    urlsMoveImageList TEXT NOT NULL,
    consecutiveFailureCount INTEGER NOT NULL DEFAULT 0,
    insertedAt INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),
    FOREIGN KEY (characterId) REFERENCES CharacterEntity(id) ON DELETE CASCADE
);

insertMove:
INSERT INTO MoveEntity(id, characterId, gameId, name, input, damage, startup, active, recovery, onBlock, onHit, onCH, guard, cancel, invulnerability, isThrow, notes, aliases, urlsWikiUrl, urlsVideoId, urlsHitboxImageList, urlsMoveImageList)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    characterId = excluded.characterId,
    gameId = excluded.gameId,
    name = excluded.name,
    input = excluded.input,
    damage = excluded.damage,
    startup = excluded.startup,
    active = excluded.active,
    recovery = excluded.recovery,
    onBlock = excluded.onBlock,
    onHit = excluded.onHit,
    onCH = excluded.onCH,
    guard = excluded.guard,
    cancel = excluded.cancel,
    invulnerability = excluded.invulnerability,
    isThrow = excluded.isThrow,
    notes = excluded.notes,
    aliases = excluded.aliases,
    urlsWikiUrl = excluded.urlsWikiUrl,
    urlsVideoId = excluded.urlsVideoId,
    urlsHitboxImageList = excluded.urlsHitboxImageList,
    urlsMoveImageList = excluded.urlsMoveImageList,
    consecutiveFailureCount = 0,
    insertedAt = CAST(strftime('%s','now') AS INTEGER) * 1000;

selectLastInsertedAtForGame:
SELECT MAX(insertedAt) AS lastInsertedAt
FROM MoveEntity
WHERE gameId = ?;

deleteAllForGame:
DELETE FROM MoveEntity
WHERE gameId = ?;

deleteByCharacter:
DELETE FROM MoveEntity
WHERE characterId = ?;

incrementFailureCountForAbsent:
UPDATE MoveEntity
SET consecutiveFailureCount = consecutiveFailureCount + 1
WHERE characterId = ? AND id NOT IN ?;

deleteExceededThreshold:
DELETE FROM MoveEntity
WHERE characterId = ? AND consecutiveFailureCount >= ?;

selectROA2ByCharacter:
SELECT m.id, m.characterId, m.gameId, m.name, m.input, m.damage, m.startup, m.active, m.recovery, m.onBlock, m.onHit, m.onCH, m.guard, m.cancel, m.invulnerability, m.isThrow, m.notes, m.aliases, m.urlsWikiUrl, m.urlsVideoId, m.urlsHitboxImageList, m.urlsMoveImageList,
       rm.mode, rm.caption, rm.hitboxCaption, rm.startupNotes, rm.totalActiveNotes, rm.endlagNotes, rm.cancelNotes, rm.landingLag, rm.landingLagNotes, rm.iasa, rm.iasaNotes, rm.totalDuration, rm.totalDurationNotes, rm.ledgeGrabFrame, rm.ledgeGrabFrameNotes, rm.hitID, rm.hitMoveID, rm.hitName, rm.hitActive, rm.customShieldSafety, rm.uniqueField, rm.articleID, rm.roa2Notes, rm.advNotes
FROM MoveEntity m
LEFT JOIN ROA2MoveEntity rm ON rm.moveId = m.id
WHERE m.characterId = ?;
