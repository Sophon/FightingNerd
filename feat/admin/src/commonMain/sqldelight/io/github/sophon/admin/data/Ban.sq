DROP TABLE IF EXISTS ban;

CREATE TABLE ban (
    offenderId TEXT NOT NULL PRIMARY KEY,
    bannedAt INTEGER NOT NULL,
    expiresAt INTEGER NOT NULL,
    authorId TEXT NOT NULL,
    preventBotUsage INTEGER NOT NULL DEFAULT 0
);

isBanned:
SELECT COUNT(*) > 0
FROM ban
WHERE offenderId = ? AND expiresAt > ?;

getBan:
SELECT *
FROM ban
WHERE offenderId = ?;

getActiveBans:
SELECT *
FROM ban
WHERE expiresAt > ?;

upsertBan:
INSERT OR REPLACE INTO ban(offenderId, bannedAt, expiresAt, authorId, preventBotUsage)
VALUES (?, ?, ?, ?, ?);

unban:
DELETE FROM ban WHERE offenderId = ?;

updatePenalty:
UPDATE ban
SET expiresAt = ?, preventBotUsage = ?
WHERE offenderId = ?;

cleanExpiredBans:
DELETE FROM ban WHERE expiresAt <= ?;