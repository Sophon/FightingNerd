CREATE TABLE ggst_character (
    character_id INTEGER PRIMARY KEY REFERENCES character(id) ON DELETE CASCADE,
    defense TEXT,
    guts TEXT,
    guard_balance TEXT,
    prejump TEXT,
    bwd_dash TEXT,
    bwd_dash_duration TEXT,
    bwd_dash_invulnerability TEXT,
    bwd_dash_airborne TEXT,
    bwd_dash_dist TEXT,
    fwd_dash TEXT,
    jump_duration TEXT,
    high_jump_duration TEXT,
    jump_height TEXT,
    high_jump_height TEXT,
    earliest_iad TEXT,
    ad_duration TEXT,
    abd_duration TEXT,
    ad_dist TEXT,
    abd_dist TEXT,
    movement_tension TEXT,
    jump_tension TEXT,
    air_dash_tension TEXT,
    walk_spd TEXT,
    bwd_walk_spd TEXT,
    dash_initial_spd TEXT,
    dash_acceleration TEXT,
    dash_friction TEXT,
    jump_gravity TEXT,
    high_jump_gravity TEXT,
    boost_attack TEXT,
    boost_defense TEXT
);

upsert:
INSERT INTO ggst_character(
    character_id,
    defense,
    guts,
    guard_balance,
    prejump,
    bwd_dash,
    bwd_dash_duration,
    bwd_dash_invulnerability,
    bwd_dash_airborne,
    bwd_dash_dist,
    fwd_dash,
    jump_duration,
    high_jump_duration,
    jump_height,
    high_jump_height,
    earliest_iad,
    ad_duration,
    abd_duration,
    ad_dist,
    abd_dist,
    movement_tension,
    jump_tension,
    air_dash_tension,
    walk_spd,
    bwd_walk_spd,
    dash_initial_spd,
    dash_acceleration,
    dash_friction,
    jump_gravity,
    high_jump_gravity,
    boost_attack,
    boost_defense
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (character_id) DO UPDATE SET
    defense = excluded.defense,
    guts = excluded.guts,
    guard_balance = excluded.guard_balance,
    prejump = excluded.prejump,
    bwd_dash = excluded.bwd_dash,
    bwd_dash_duration = excluded.bwd_dash_duration,
    bwd_dash_invulnerability = excluded.bwd_dash_invulnerability,
    bwd_dash_airborne = excluded.bwd_dash_airborne,
    bwd_dash_dist = excluded.bwd_dash_dist,
    fwd_dash = excluded.fwd_dash,
    jump_duration = excluded.jump_duration,
    high_jump_duration = excluded.high_jump_duration,
    jump_height = excluded.jump_height,
    high_jump_height = excluded.high_jump_height,
    earliest_iad = excluded.earliest_iad,
    ad_duration = excluded.ad_duration,
    abd_duration = excluded.abd_duration,
    ad_dist = excluded.ad_dist,
    abd_dist = excluded.abd_dist,
    movement_tension = excluded.movement_tension,
    jump_tension = excluded.jump_tension,
    air_dash_tension = excluded.air_dash_tension,
    walk_spd = excluded.walk_spd,
    bwd_walk_spd = excluded.bwd_walk_spd,
    dash_initial_spd = excluded.dash_initial_spd,
    dash_acceleration = excluded.dash_acceleration,
    dash_friction = excluded.dash_friction,
    jump_gravity = excluded.jump_gravity,
    high_jump_gravity = excluded.high_jump_gravity,
    boost_attack = excluded.boost_attack,
    boost_defense = excluded.boost_defense;

selectAll:
SELECT *
FROM ggst_character;
