import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;

CREATE TABLE move (
    id INTEGER PRIMARY KEY,
    character_id INTEGER NOT NULL REFERENCES character(id) ON DELETE CASCADE,
    input TEXT NOT NULL,
    remote_id TEXT,
    position INTEGER NOT NULL,
    name TEXT,
    damage TEXT,
    startup TEXT,
    on_block TEXT,
    on_hit TEXT,
    on_ch TEXT,
    active TEXT,
    cancel TEXT,
    recovery TEXT,
    guard TEXT,
    invulnerability TEXT,
    type TEXT,
    is_throw INTEGER AS Boolean NOT NULL,
    notes TEXT AS List<String> NOT NULL,
    wiki_url TEXT NOT NULL,
    video_id TEXT,
    video_url TEXT,
    hitbox_image_list TEXT AS List<String> NOT NULL,
    move_image_list TEXT AS List<String> NOT NULL,
    strike_count INTEGER NOT NULL DEFAULT 0,
    UNIQUE (character_id, input)
);

upsert:
INSERT INTO move(character_id, input, remote_id, position, name, damage, startup, on_block, on_hit, on_ch, active, cancel, recovery, guard, invulnerability, type, is_throw, notes, wiki_url, video_id, video_url, hitbox_image_list, move_image_list)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (character_id, input) DO UPDATE SET
    remote_id = excluded.remote_id,
    position = excluded.position,
    name = excluded.name,
    damage = excluded.damage,
    startup = excluded.startup,
    on_block = excluded.on_block,
    on_hit = excluded.on_hit,
    on_ch = excluded.on_ch,
    active = excluded.active,
    cancel = excluded.cancel,
    recovery = excluded.recovery,
    guard = excluded.guard,
    invulnerability = excluded.invulnerability,
    type = excluded.type,
    is_throw = excluded.is_throw,
    notes = excluded.notes,
    wiki_url = excluded.wiki_url,
    video_id = excluded.video_id,
    video_url = excluded.video_url,
    hitbox_image_list = excluded.hitbox_image_list,
    move_image_list = excluded.move_image_list,
    strike_count = 0;

selectId:
SELECT id
FROM move
WHERE character_id = ? AND input = ?;

-- a struck move keeps its old position, so positions can tie
selectByCharacter:
SELECT *
FROM move
WHERE character_id = (SELECT id FROM character WHERE game = ? AND natural_id = ?)
ORDER BY position, id;

strikeByCharacter:
UPDATE move
SET strike_count = strike_count + 1
WHERE character_id = ?;

deleteStruckByCharacter:
DELETE FROM move
WHERE character_id = ? AND strike_count >= ?;

deleteByGame:
DELETE FROM move
WHERE character_id IN (SELECT id FROM character WHERE game = ?);
