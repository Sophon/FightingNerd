CREATE TABLE GGSTCharacterEntity (
    characterId TEXT NOT NULL PRIMARY KEY,
    defense TEXT,
    guts TEXT,
    guardBalance TEXT,
    prejump TEXT,
    bwdDash TEXT,
    bwdDashDuration TEXT,
    bwdDashInvulnerability TEXT,
    bwdDashAirborne TEXT,
    bwdDashDist TEXT,
    fwdDash TEXT,
    jumpDuration TEXT,
    highJumpDuration TEXT,
    jumpHeight TEXT,
    highJumpHeight TEXT,
    earliestIAD TEXT,
    adDuration TEXT,
    abdDuration TEXT,
    adDist TEXT,
    abdDist TEXT,
    movementTension TEXT,
    jumpTension TEXT,
    airDashTension TEXT,
    walkSpd TEXT,
    bwdWalkSpd TEXT,
    dashInitialSpd TEXT,
    dashAcceleration TEXT,
    dashFriction TEXT,
    jumpGravity TEXT,
    highJumpGravity TEXT,
    boostAttack TEXT,
    boostDefense TEXT,
    FOREIGN KEY (characterId) REFERENCES CharacterEntity(id) ON DELETE CASCADE
);

insertGGSTCharacter:
INSERT OR REPLACE INTO GGSTCharacterEntity(characterId, defense, guts, guardBalance, prejump, bwdDash, bwdDashDuration, bwdDashInvulnerability, bwdDashAirborne, bwdDashDist, fwdDash, jumpDuration, highJumpDuration, jumpHeight, highJumpHeight, earliestIAD, adDuration, abdDuration, adDist, abdDist, movementTension, jumpTension, airDashTension, walkSpd, bwdWalkSpd, dashInitialSpd, dashAcceleration, dashFriction, jumpGravity, highJumpGravity, boostAttack, boostDefense)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
