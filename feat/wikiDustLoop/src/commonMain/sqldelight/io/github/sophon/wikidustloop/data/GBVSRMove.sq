CREATE TABLE GBVSRMoveEntity (
    moveId TEXT NOT NULL PRIMARY KEY,
    meter TEXT,
    level TEXT,
    cooldown TEXT,
    cls TEXT,
    FOREIGN KEY (moveId) REFERENCES MoveEntity(id) ON DELETE CASCADE
);

insertGBVSRMove:
INSERT OR REPLACE INTO GBVSRMoveEntity(moveId, meter, level, cooldown, cls)
VALUES (?, ?, ?, ?, ?);
