import kotlin.Boolean;

CREATE TABLE MoveEntity (
    id TEXT NOT NULL PRIMARY KEY,
    characterId TEXT NOT NULL,
    gameId TEXT NOT NULL,
    name TEXT,
    input TEXT NOT NULL,
    damage TEXT,
    startup TEXT,
    active TEXT,
    recovery TEXT,
    onBlock TEXT,
    onHit TEXT,
    onCH TEXT,
    guard TEXT,
    cancel TEXT,
    invulnerability TEXT,
    isThrow INTEGER AS Boolean NOT NULL DEFAULT 0,
    type TEXT,
    notes TEXT NOT NULL,
    aliases TEXT NOT NULL,
    urlsWikiUrl TEXT,
    urlsVideoId TEXT,
    urlsVideoUrl TEXT,
    urlsHitboxImageList TEXT NOT NULL,
    urlsMoveImageList TEXT NOT NULL,
    consecutiveFailureCount INTEGER NOT NULL DEFAULT 0,
    insertedAt INTEGER NOT NULL DEFAULT (CAST(strftime('%s','now') AS INTEGER) * 1000),
    FOREIGN KEY (characterId) REFERENCES CharacterEntity(id) ON DELETE CASCADE
);

insertMove:
INSERT INTO MoveEntity(id, characterId, gameId, name, input, damage, startup, active, recovery, onBlock, onHit, onCH, guard, cancel, invulnerability, isThrow, type, notes, aliases, urlsWikiUrl, urlsVideoId, urlsVideoUrl, urlsHitboxImageList, urlsMoveImageList)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    characterId = excluded.characterId,
    gameId = excluded.gameId,
    name = excluded.name,
    input = excluded.input,
    damage = excluded.damage,
    startup = excluded.startup,
    active = excluded.active,
    recovery = excluded.recovery,
    onBlock = excluded.onBlock,
    onHit = excluded.onHit,
    onCH = excluded.onCH,
    guard = excluded.guard,
    cancel = excluded.cancel,
    invulnerability = excluded.invulnerability,
    isThrow = excluded.isThrow,
    type = excluded.type,
    notes = excluded.notes,
    aliases = excluded.aliases,
    urlsWikiUrl = excluded.urlsWikiUrl,
    urlsVideoId = excluded.urlsVideoId,
    urlsVideoUrl = excluded.urlsVideoUrl,
    urlsHitboxImageList = excluded.urlsHitboxImageList,
    urlsMoveImageList = excluded.urlsMoveImageList,
    consecutiveFailureCount = 0,
    insertedAt = CAST(strftime('%s','now') AS INTEGER) * 1000;

selectLastInsertedAtForGame:
SELECT MAX(insertedAt) AS lastInsertedAt
FROM MoveEntity
WHERE gameId = ?;

deleteAllForGame:
DELETE FROM MoveEntity
WHERE gameId = ?;

deleteByCharacter:
DELETE FROM MoveEntity
WHERE characterId = ?;

incrementFailureCountForAbsent:
UPDATE MoveEntity
SET consecutiveFailureCount = consecutiveFailureCount + 1
WHERE characterId = ? AND id NOT IN ?;

deleteExceededThreshold:
DELETE FROM MoveEntity
WHERE characterId = ? AND consecutiveFailureCount >= ?;

selectSF6ByCharacter:
SELECT m.id, m.characterId, m.gameId, m.name, m.input, m.damage, m.startup, m.active, m.recovery, m.onBlock, m.onHit, m.onCH, m.guard, m.cancel, m.invulnerability, m.isThrow, m.type, m.notes, m.aliases, m.urlsWikiUrl, m.urlsVideoId, m.urlsVideoUrl, m.urlsHitboxImageList, m.urlsMoveImageList,
       sm.images, sm.chip, sm.dmgScaling, sm.total, sm.hitConfirm, sm.punishAdv, sm.perfParryAdv, sm.DRcOH, sm.DRcOB, sm.DROH, sm.DROB, sm.hitStun, sm.blockStun, sm.hitStop, sm.driveDmgOnBlock, sm.driveDmgOnHit, sm.driveGain, sm.superGainOnHit, sm.superGainOnBlock, sm.armor, sm.airborne, sm.jugStart, sm.jugIncrease, sm.jugLimit, sm.projectileSpeed, sm.attackRange
FROM MoveEntity m
LEFT JOIN SF6MoveEntity sm ON sm.moveId = m.id
WHERE m.characterId = ?;

selectMK1ByCharacter:
SELECT m.id, m.characterId, m.gameId, m.name, m.input, m.damage, m.startup, m.active, m.recovery, m.onBlock, m.onHit, m.onCH, m.guard, m.cancel, m.invulnerability, m.isThrow, m.type, m.notes, m.aliases, m.urlsWikiUrl, m.urlsVideoId, m.urlsVideoUrl, m.urlsHitboxImageList, m.urlsMoveImageList,
       km.cost, km.chip, km.flawlessBlockAdv, km.hitCancelAdv, km.blockCancelAdv, km.punish
FROM MoveEntity m
LEFT JOIN MK1MoveEntity km ON km.moveId = m.id
WHERE m.characterId = ?;

selectAVLByCharacter:
SELECT m.id, m.characterId, m.gameId, m.name, m.input, m.damage, m.startup, m.active, m.recovery, m.onBlock, m.onHit, m.onCH, m.guard, m.cancel, m.invulnerability, m.isThrow, m.type, m.notes, m.aliases, m.urlsWikiUrl, m.urlsVideoId, m.urlsVideoUrl, m.urlsHitboxImageList, m.urlsMoveImageList,
       am.chiDamage, am.flow
FROM MoveEntity m
LEFT JOIN AVLMoveEntity am ON am.moveId = m.id
WHERE m.characterId = ?;
