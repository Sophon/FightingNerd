CREATE TABLE ggxrd_character (
    character_id INTEGER PRIMARY KEY REFERENCES character(id) ON DELETE CASCADE,
    defense TEXT,
    guts TEXT,
    stun_resistance TEXT,
    weight TEXT,
    prejump TEXT,
    backdash_duration TEXT,
    backdash_distance TEXT,
    backdash_invuln TEXT,
    dash_forward TEXT,
    dash_forward_duration TEXT,
    dash_resistance TEXT,
    dash_acceleration TEXT,
    initial_dash_speed TEXT,
    friction TEXT,
    walk_speed_forwards TEXT,
    walk_speed_backwards TEXT,
    air_dash_forwards_speed TEXT,
    air_dash_forwards_startup TEXT,
    air_dash_backwards_speed TEXT,
    air_dash_backwards_startup TEXT,
    landing_recovery TEXT,
    throw_range TEXT,
    air_throw_range TEXT,
    risc_gain_rate TEXT,
    risc_inertia TEXT,
    wakeup_face_up TEXT,
    wakeup_face_down TEXT,
    walk_forwards_tension_gain TEXT,
    dash_tension_gain TEXT,
    jump_forwards_tension_gain TEXT,
    air_dash_forwards_tension_gain TEXT
);

upsert:
INSERT INTO ggxrd_character(
    character_id,
    defense,
    guts,
    stun_resistance,
    weight,
    prejump,
    backdash_duration,
    backdash_distance,
    backdash_invuln,
    dash_forward,
    dash_forward_duration,
    dash_resistance,
    dash_acceleration,
    initial_dash_speed,
    friction,
    walk_speed_forwards,
    walk_speed_backwards,
    air_dash_forwards_speed,
    air_dash_forwards_startup,
    air_dash_backwards_speed,
    air_dash_backwards_startup,
    landing_recovery,
    throw_range,
    air_throw_range,
    risc_gain_rate,
    risc_inertia,
    wakeup_face_up,
    wakeup_face_down,
    walk_forwards_tension_gain,
    dash_tension_gain,
    jump_forwards_tension_gain,
    air_dash_forwards_tension_gain
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT (character_id) DO UPDATE SET
    defense = excluded.defense,
    guts = excluded.guts,
    stun_resistance = excluded.stun_resistance,
    weight = excluded.weight,
    prejump = excluded.prejump,
    backdash_duration = excluded.backdash_duration,
    backdash_distance = excluded.backdash_distance,
    backdash_invuln = excluded.backdash_invuln,
    dash_forward = excluded.dash_forward,
    dash_forward_duration = excluded.dash_forward_duration,
    dash_resistance = excluded.dash_resistance,
    dash_acceleration = excluded.dash_acceleration,
    initial_dash_speed = excluded.initial_dash_speed,
    friction = excluded.friction,
    walk_speed_forwards = excluded.walk_speed_forwards,
    walk_speed_backwards = excluded.walk_speed_backwards,
    air_dash_forwards_speed = excluded.air_dash_forwards_speed,
    air_dash_forwards_startup = excluded.air_dash_forwards_startup,
    air_dash_backwards_speed = excluded.air_dash_backwards_speed,
    air_dash_backwards_startup = excluded.air_dash_backwards_startup,
    landing_recovery = excluded.landing_recovery,
    throw_range = excluded.throw_range,
    air_throw_range = excluded.air_throw_range,
    risc_gain_rate = excluded.risc_gain_rate,
    risc_inertia = excluded.risc_inertia,
    wakeup_face_up = excluded.wakeup_face_up,
    wakeup_face_down = excluded.wakeup_face_down,
    walk_forwards_tension_gain = excluded.walk_forwards_tension_gain,
    dash_tension_gain = excluded.dash_tension_gain,
    jump_forwards_tension_gain = excluded.jump_forwards_tension_gain,
    air_dash_forwards_tension_gain = excluded.air_dash_forwards_tension_gain;

selectAll:
SELECT *
FROM ggxrd_character;
