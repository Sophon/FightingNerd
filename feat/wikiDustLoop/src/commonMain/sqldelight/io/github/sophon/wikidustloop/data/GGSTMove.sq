CREATE TABLE GGSTMoveEntity (
    moveId TEXT NOT NULL PRIMARY KEY,
    riscGain TEXT,
    riscLoss TEXT,
    wallDamage TEXT,
    inputTension TEXT,
    chipRatio TEXT,
    otgType TEXT,
    prorate TEXT,
    level TEXT,
    FOREIGN KEY (moveId) REFERENCES MoveEntity(id) ON DELETE CASCADE
);

insertGGSTMove:
INSERT OR REPLACE INTO GGSTMoveEntity(moveId, riscGain, riscLoss, wallDamage, inputTension, chipRatio, otgType, prorate, level)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);
