import kotlin.Boolean;

CREATE TABLE MoveEntity (
    id TEXT NOT NULL PRIMARY KEY,
    characterId TEXT NOT NULL,
    name TEXT,
    input TEXT NOT NULL,
    damage TEXT,
    startup TEXT,
    onBlock TEXT,
    onHit TEXT,
    onCH TEXT,
    active TEXT,
    cancel TEXT,
    recovery TEXT,
    guard TEXT,
    invulnerability TEXT,
    isThrow INTEGER AS Boolean NOT NULL DEFAULT 0,
    notes TEXT NOT NULL,
    aliases TEXT NOT NULL,
    urlsVideoId TEXT,
    urlsHitboxImageList TEXT NOT NULL,
    urlsMoveImageList TEXT NOT NULL,
    urlsWikiUrl TEXT,
    insertedAt INTEGER NOT NULL
);

insertMove:
INSERT OR IGNORE INTO MoveEntity(id, characterId, name, input, damage, startup, onBlock, onHit, onCH, active, cancel, recovery, guard, invulnerability, isThrow, notes, aliases, urlsVideoId, urlsHitboxImageList, urlsMoveImageList, urlsWikiUrl, insertedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllMoves:
DELETE FROM MoveEntity;

selectAllCommon:
SELECT *
FROM MoveEntity;

selectLastInsertTimestamp:
SELECT MAX(insertedAt) AS lastInsertedAt
FROM MoveEntity;

hasMovesForCharacter:
SELECT EXISTS(SELECT 1 FROM MoveEntity WHERE characterId = ?);


CREATE TABLE t8_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    isHeat INTEGER AS Boolean NOT NULL,
    isHoming INTEGER AS Boolean NOT NULL,
    stance TEXT,
    isPowerCrush INTEGER AS Boolean NOT NULL,
    isHighCrush INTEGER AS Boolean NOT NULL,
    isLowCrush INTEGER AS Boolean NOT NULL
);

CREATE TABLE sf6_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    type TEXT,
    images TEXT,
    chip TEXT,
    dmgScaling TEXT,
    total TEXT,
    hitConfirm TEXT,
    punishAdv TEXT,
    perfParryAdv TEXT,
    DRcOH TEXT,
    DRcOB TEXT,
    DROH TEXT,
    DROB TEXT,
    hitStun TEXT,
    blockStun TEXT,
    hitStop TEXT,
    driveDmgOnBlock TEXT,
    driveDmgOnHit TEXT,
    driveGain TEXT,
    superGainOnHit TEXT,
    superGainOnBlock TEXT,
    armor TEXT,
    airborne TEXT,
    jugStart TEXT,
    jugIncrease TEXT,
    jugLimit TEXT,
    projectileSpeed TEXT,
    attackRange TEXT
);

CREATE TABLE kof15_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    stun TEXT
);

CREATE TABLE cotw_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    revDamage TEXT
);

CREATE TABLE ggst_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    type TEXT,
    riscGain TEXT,
    riscLoss TEXT,
    wallDamage TEXT,
    inputTension TEXT,
    chipRatio TEXT,
    otgType TEXT,
    prorate TEXT,
    level TEXT
);

CREATE TABLE dbfz_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    attribute TEXT,
    smash TEXT,
    kiGain TEXT,
    prorate TEXT,
    blockStun TEXT,
    groundHit TEXT,
    airHit TEXT,
    type TEXT,
    level TEXT
);

CREATE TABLE gbvsr_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    meter TEXT,
    level TEXT,
    cooldown TEXT,
    cls TEXT,
    type TEXT
);

CREATE TABLE mk_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    moveType TEXT,
    cost TEXT NOT NULL,
    chip TEXT,
    flawlessBlockAdv TEXT,
    hitCancelAdv TEXT,
    blockCancelAdv TEXT,
    punish TEXT
);

CREATE TABLE mb_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    inputInfo TEXT,
    subtitle TEXT,
    minDamage TEXT,
    property TEXT,
    cost TEXT,
    attribute TEXT,
    landing TEXT,
    overall TEXT
);

CREATE TABLE bb_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    onODR TEXT,
    attribute TEXT,
    p1 TEXT,
    p2 TEXT,
    starter TEXT,
    level TEXT,
    blockstun TEXT,
    groundHit TEXT,
    airHit TEXT,
    groundCH TEXT,
    airCH TEXT,
    blockstop TEXT,
    hitstop TEXT,
    chStop TEXT,
    cancelTiming TEXT,
    type TEXT
);

CREATE TABLE uni2_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    inputInfo TEXT,
    subtitle TEXT,
    minDamage TEXT,
    type TEXT,
    cancelWindow TEXT,
    property TEXT,
    cost TEXT,
    attribute TEXT,
    landing TEXT,
    overall TEXT,
    assaultAdv TEXT,
    blockstun TEXT,
    groundHit TEXT,
    airHit TEXT,
    groundCH TEXT,
    airCH TEXT,
    hitstop TEXT,
    CHstop TEXT,
    proration TEXT,
    comboP1 TEXT,
    comboP2 TEXT
);

CREATE TABLE vsav_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    inputInfo TEXT,
    subtitle TEXT,
    whiteDmg TEXT,
    renda TEXT,
    meter TEXT,
    reaction TEXT,
    curseTime TEXT
);

CREATE TABLE avl_move_props (
    moveId TEXT NOT NULL PRIMARY KEY REFERENCES MoveEntity(id),
    chiDamage TEXT,
    flow TEXT
);


insertT8Props:
INSERT OR IGNORE INTO t8_move_props(moveId, isHeat, isHoming, stance, isPowerCrush, isHighCrush, isLowCrush)
VALUES (?, ?, ?, ?, ?, ?, ?);

selectAllT8:
SELECT MoveEntity.*, t8_move_props.*
FROM MoveEntity
LEFT JOIN t8_move_props ON MoveEntity.id = t8_move_props.moveId;

deleteAllT8Props:
DELETE FROM t8_move_props;


