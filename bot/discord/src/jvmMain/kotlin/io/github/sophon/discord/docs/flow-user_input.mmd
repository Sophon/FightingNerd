flowchart TD
    subgraph Kord
        bot["Bot"]
        poster["Poster"]
    end

    subgraph APPLICATION
        process["Process user input"]
        route{"Command router"}
        fd_svc["Char/Move service"]
        fd_port["FD port"]
        command1_port["Command port 1"]
    end

    subgraph ADAPTER
        wiki_adp["Wiki"]
        feat1_adp["Feature 1 adapter"]
    end

    subgraph FEATURES
        wiki["Wiki"]
        feat1["Feature 1"]
    end

    bot -->|"1. user query"| process
    process -->|"2. Command, query"| route --> |"3. query"| fd_svc
    fd_svc --> |"4. nothing, then char ID"| fd_port --> |"5. characters, moves"| fd_svc
    fd_svc --> |"6. response"| route --> process
    process --> bot -->|"7. embed"| poster

    route --> command1_port

    wiki_adp -.- fd_port
    feat1_adp -.- command1_port

    wiki_adp -.- wiki
    feat1_adp -.- feat1


    style Kord stroke:orange,stroke-dasharray:5 5,fill:none
    style APPLICATION stroke:green,stroke-dasharray:5 5,fill:none
    style ADAPTER stroke:blue,stroke-dasharray:5 5,fill:none
    style FEATURES stroke-dasharray:5 5,fill:none

    classDef kord stroke:orange
    classDef application stroke:green
    classDef adapter stroke:blue
    classDef outboundPort stroke:green,stroke-dasharray:3 3

    class bot,poster kord
    class process,route,fd_svc application
    class fd_port,command1_port outboundPort
    class wiki_adp,feat1_adp adapter
