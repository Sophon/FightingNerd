CREATE TABLE MK1MoveEntity (
    moveId TEXT NOT NULL PRIMARY KEY,
    moveType TEXT,
    cost TEXT NOT NULL,
    chip TEXT,
    flawlessBlockAdv TEXT,
    hitCancelAdv TEXT,
    blockCancelAdv TEXT,
    punish TEXT,
    FOREIGN KEY (moveId) REFERENCES MoveEntity(id) ON DELETE CASCADE
);

insertMK1Move:
INSERT OR REPLACE INTO MK1MoveEntity(moveId, moveType, cost, chip, flawlessBlockAdv, hitCancelAdv, blockCancelAdv, punish)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);
