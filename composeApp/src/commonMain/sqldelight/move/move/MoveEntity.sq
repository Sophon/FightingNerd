INSERT OR IGNORE  INTO sf6_move_props(moveId, type, images, chip, dmgScaling, total, hitConfirm, punishAdv, perfParryAdv, DRcOH, DRcOB, DROH, DROB, hitStun, blockStun, hitStop, driveDmgOnBlock, driveDmgOnHit, driveGain, superGainOnHit, superGainOnBlock, armor, airborne, jugStart, jugIncrease, jugLimit, projectileSpeed, attackRange)
